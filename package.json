{
  "name": "rekadigi-automotive-marketplace-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/dev-server.ts",
  "description": "Automotive Marketplace REST API - modular monolith on Bun, Elysia and PostgreSQL.",
  "scripts": {
    "dev": "bun --watch src/dev-server.ts",
    "start": "bun run src/dev-server.ts",
    "build": "bun build src/dev-server.ts --target bun --outdir dist --minify",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run src/database/migrate.ts",
    "db:seed": "bun run src/database/seeds/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.16",
    "elysia": "^1.4.30",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1"
  }
}
